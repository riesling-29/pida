# Set using a secret manager, shell environment, or node --env-file=.env dist/server.js.
# Generate a random Pida application token of at least 32 characters. Do not commit it.
PIDA_API_TOKEN=
PIDA_PROVIDER=mock
PORT=8787
# Endpoint mode only:
# PIDA_PROVIDER=endpoint
# PIDA_API=openai-completions
# PIDA_BASE_URL=https://company-gateway.example.com/v1
# PIDA_MODEL=your-deployment-name
# PIDA_LLM_API_KEY=
# PIDA_CONTEXT_WINDOW=32000
# PIDA_MAX_TOKENS=2048
# PIDA_ALLOW_HTTP=false
