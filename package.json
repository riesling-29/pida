{
  "name": "pida-core",
  "version": "0.8.1",
  "description": "Embedded Pi runtime with authorized business tools and a session HTTP API",
  "scripts": {
    "build": "node scripts/task.mjs build",
    "check": "node scripts/task.mjs check",
    "test": "node scripts/task.mjs test",
    "start": "node dist/cli.js start",
    "prepack": "node scripts/task.mjs build",
    "pida": "node scripts/task.mjs pida",
    "demo": "node dist/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "quickjs-emscripten": "0.32.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "docs",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "scripts/task.mjs",
    "packs"
  ],
  "overrides": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-codemode": "1.2.0",
    "@earendil-works/pi-mcp": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@earendil-works/pi-telemetry": "1.2.0"
  },
  "bin": {
    "pida": "./dist/cli.js"
  },
  "optionalDependencies": {
    "playwright": "1.64.1"
  }
}
